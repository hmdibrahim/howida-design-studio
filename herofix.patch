From 6725a168212bbb3ddea77de3a62d383911dd0e35 Mon Sep 17 00:00:00 2001
From: Claude <noreply@anthropic.com>
Date: Wed, 29 Jul 2026 06:50:48 +0000
Subject: [PATCH] Fix hero text contrast and turn it into a rotating photo
 slideshow

- Hero now cross-fades through 5 real project photos every 5s (paused
  under prefers-reduced-motion) instead of a single static image
- Add a directional scrim (RTL-aware) plus a top strip and bottom
  vignette so heading/subtitle/buttons stay legible over any photo
- Hero text switches to white/cream, new outline-on-dark button variant
  for the secondary CTA
- Header: transparent-over-hero nav/logo text switches to light until
  scrolled, matching the new top scrim
---
 src/components/Button.astro         |  3 +-
 src/components/Header.astro         | 26 ++++++++++++++---
 src/components/views/HomeView.astro | 44 +++++++++++++++++++++++++----
 3 files changed, 63 insertions(+), 10 deletions(-)

diff --git a/src/components/Button.astro b/src/components/Button.astro
index 1ac8de8..876edff 100644
--- a/src/components/Button.astro
+++ b/src/components/Button.astro
@@ -1,7 +1,7 @@
 ---
 interface Props {
   href: string;
-  variant?: 'primary' | 'secondary' | 'ghost' | 'on-dark';
+  variant?: 'primary' | 'secondary' | 'ghost' | 'on-dark' | 'outline-on-dark';
   class?: string;
 }
 
@@ -12,6 +12,7 @@ const variants: Record<string, string> = {
   secondary: 'border border-gold/40 text-gold-deep hover:border-gold-dark hover:bg-gold-light/40',
   ghost: 'text-ink hover:bg-gold-light/40',
   'on-dark': 'bg-cream text-espresso hover:bg-white shadow-sm hover:shadow-md',
+  'outline-on-dark': 'border border-white/50 text-white hover:border-white hover:bg-white/10',
 };
 ---
 
diff --git a/src/components/Header.astro b/src/components/Header.astro
