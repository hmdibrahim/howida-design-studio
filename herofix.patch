+    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/45 to-transparent" aria-hidden="true" />
   </div>
   <div class="container-page relative flex h-full flex-col justify-end pb-14 sm:pb-20">
     <div class="max-w-xl animate-fade-up">
-      <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-gold-deep">{t.home.heroKicker}</p>
