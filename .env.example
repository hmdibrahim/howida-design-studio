# Public site URL used for canonical links, sitemap, and Open Graph tags.
# Set this to the real production domain before deploying.
PUBLIC_SITE_URL=https://www.howidadesignstudio.com

# Resend (https://resend.com) API key used by src/lib/email.ts to send
# contact-form enquiries. Required in production — without it the contact
# API route logs the submission instead of emailing it (development only).
RESEND_API_KEY=

# Mailbox that receives contact-form enquiries.
CONTACT_TO_EMAIL=howida.yo.ho@gmail.com

# "From" address used when sending enquiry emails. Must be a domain
# verified with your email provider (Resend requires domain verification
# for anything other than their onboarding@resend.dev test address).
CONTACT_FROM_EMAIL="Howida design studio <onboarding@resend.dev>"
