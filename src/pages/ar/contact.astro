---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactView from '../../components/views/ContactView.astro';
import { useTranslations } from '../../i18n/utils';

const lang = 'ar';
const t = useTranslations(lang);
const title = `${t.contact.title} | ${t.meta.siteName}`;
const description = 'تواصل مع Howida design studio لاستفسارات التصميم الداخلي والتشطيب في جميع أنحاء الإمارات. اتصل بنا عبر الهاتف أو البريد الإلكتروني.';
---

<BaseLayout lang={lang} title={title} description={description} path="contact">
  <ContactView lang={lang} />
</BaseLayout>
