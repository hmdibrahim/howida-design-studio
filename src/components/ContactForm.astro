---
import { useTranslations } from '../i18n/utils';
import type { Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  services: { slug: string; title: string }[];
  status?: 'success' | 'error' | null;
}

const { lang, services, status = null } = Astro.props;
const t = useTranslations(lang);
---

<div id="contact-form-wrapper" class="rounded-2xl border border-gold/15 bg-white/70 p-6 sm:p-8">
  <h2 class="text-xl font-bold text-ink">{t.contact.formTitle}</h2>

  <div id="form-status" role="status" aria-live="polite" class="mt-4 empty:mt-0 empty:hidden">
    {
      status === 'success' && (
        <div class="rounded-xl border border-green-600/25 bg-green-50 p-4 text-sm text-green-900">
          <p class="font-semibold">{t.contact.successTitle}</p>
          <p class="mt-1">{t.contact.successBody}</p>
        </div>
      )
    }
    {
      status === 'error' && (
        <div role="alert" class="rounded-xl border border-red-600/25 bg-red-50 p-4 text-sm text-red-900">
          <p class="font-semibold">{t.contact.errorTitle}</p>
          <p class="mt-1">{t.contact.errorBody}</p>
        </div>
      )
    }
  </div>

  <form id="contact-form" method="POST" action="/api/contact" class="mt-6 grid gap-5" novalidate>
    <input type="hidden" name="lang" value={lang} />
    <input type="hidden" name="startedAt" id="startedAt" value="" />

    <div class="honeypot-field" aria-hidden="true">
      <label for="company">Company</label>
      <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="name" class="block text-sm font-medium text-ink">{t.contact.nameLabel}</label>
        <input
          type="text"
          id="name"
          name="name"
          required
          minlength="2"
          maxlength="120"
          autocomplete="name"
          placeholder={t.contact.namePlaceholder}
          class="field-input"
          aria-describedby="name-error"
        />
        <p id="name-error" class="field-error"></p>
      </div>
      <div>
        <label for="email" class="block text-sm font-medium text-ink">{t.contact.emailLabel}</label>
        <input
          type="email"
          id="email"
          name="email"
          required
          maxlength="180"
          autocomplete="email"
          placeholder={t.contact.emailPlaceholder}
          class="field-input"
          dir="ltr"
          aria-describedby="email-error"
        />
        <p id="email-error" class="field-error"></p>
      </div>
    </div>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <label for="phone" class="block text-sm font-medium text-ink">{t.contact.phoneLabel}</label>
        <input
          type="tel"
          id="phone"
          name="phone"
          maxlength="30"
          autocomplete="tel"
          placeholder={t.contact.phonePlaceholder}
          class="field-input"
          dir="ltr"
          aria-describedby="phone-error"
        />
        <p id="phone-error" class="field-error"></p>
      </div>
      <div>
        <label for="service" class="block text-sm font-medium text-ink">{t.contact.serviceLabel}</label>
        <select id="service" name="service" class="field-input">
          <option value="">{t.contact.servicePlaceholder}</option>
          {services.map((service) => <option value={service.title}>{service.title}</option>)}
        </select>
      </div>
    </div>

    <div>
      <label for="message" class="block text-sm font-medium text-ink">{t.contact.messageLabel}</label>
      <textarea
        id="message"
        name="message"
        required
        minlength="10"
        maxlength="2000"
        rows="5"
        placeholder={t.contact.messagePlaceholder}
        class="field-input resize-y"
        aria-describedby="message-error"
      ></textarea>
      <p id="message-error" class="field-error"></p>
    </div>

    <div>
      <button type="submit" id="submit-button" class="inline-flex w-full items-center justify-center rounded-full bg-gold-dark px-6 py-3.5 text-sm font-semibold text-white transition-colors hover:bg-espresso-2 disabled:cursor-not-allowed disabled:opacity-70 sm:w-auto">
        <span data-label={t.contact.submit} data-loading={t.contact.submitting}>{t.contact.submit}</span>
      </button>
      <p class="mt-3 text-xs text-body">{t.contact.privacyNote}</p>
    </div>
  </form>
</div>

<script
  is:inline
  type="application/json"
  id="contact-i18n"
  set:html={JSON.stringify({
    errorRequired: t.contact.errorRequired,
    errorEmail: t.contact.errorEmail,
    errorPhone: t.contact.errorPhone,
    errorMessage: t.contact.errorMessage,
    submit: t.contact.submit,
    submitting: t.contact.submitting,
    successTitle: t.contact.successTitle,
    successBody: t.contact.successBody,
    errorTitle: t.contact.errorTitle,
    errorBody: t.contact.errorBody,
  })}
/>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const statusRegion = document.getElementById('form-status');
  const startedAtInput = document.getElementById('startedAt') as HTMLInputElement | null;
  const i18nScript = document.getElementById('contact-i18n');
  const i18n = i18nScript ? JSON.parse(i18nScript.textContent || '{}') : {};

  if (startedAtInput) startedAtInput.value = String(Date.now());

  function fieldError(id: string, message: string) {
    const el = document.getElementById(id);
    if (el) el.textContent = message;
  }

  function clearErrors() {
    ['name-error', 'email-error', 'phone-error', 'message-error'].forEach((id) => fieldError(id, ''));
  }

  function renderStatus(kind: 'success' | 'error', title: string, body: string) {
    if (!statusRegion) return;
    const isSuccess = kind === 'success';
    statusRegion.innerHTML = '';
    const box = document.createElement('div');
    box.className = isSuccess
      ? 'rounded-xl border border-green-600/25 bg-green-50 p-4 text-sm text-green-900'
      : 'rounded-xl border border-red-600/25 bg-red-50 p-4 text-sm text-red-900';
    if (!isSuccess) box.setAttribute('role', 'alert');
    const titleEl = document.createElement('p');
    titleEl.className = 'font-semibold';
    titleEl.textContent = title;
    const bodyEl = document.createElement('p');
    bodyEl.className = 'mt-1';
    bodyEl.textContent = body;
    box.append(titleEl, bodyEl);
    statusRegion.append(box);
    statusRegion.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
  }

  if (form) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      const submitButton = document.getElementById('submit-button') as HTMLButtonElement | null;
      const label = submitButton?.querySelector('span');
      if (submitButton) submitButton.disabled = true;
      if (label) label.textContent = i18n.submitting ?? 'Sending...';

      const formData = new FormData(form);
      const payload = Object.fromEntries(formData.entries());

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        const result = await response.json();

        if (result.ok) {
          form.reset();
          if (startedAtInput) startedAtInput.value = String(Date.now());
          renderStatus('success', i18n.successTitle, i18n.successBody);
        } else if (result.fields) {
          if (result.fields.name) fieldError('name-error', i18n.errorRequired);
          if (result.fields.email) fieldError('email-error', i18n.errorEmail);
          if (result.fields.phone) fieldError('phone-error', i18n.errorPhone);
          if (result.fields.message) fieldError('message-error', i18n.errorMessage);
          renderStatus('error', i18n.errorTitle, i18n.errorBody);
        } else {
          renderStatus('error', i18n.errorTitle, i18n.errorBody);
        }
      } catch {
        renderStatus('error', i18n.errorTitle, i18n.errorBody);
      } finally {
        if (submitButton) submitButton.disabled = false;
        if (label) label.textContent = i18n.submit ?? 'Send Message';
      }
    });
  }

  if (window.location.search.includes('status=')) {
    const url = new URL(window.location.href);
    url.searchParams.delete('status');
    window.history.replaceState({}, '', url.pathname + url.search + url.hash);
  }
</script>

<style>
  :global(.field-input) {
    margin-top: 0.375rem;
    width: 100%;
    border-radius: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-gold) 35%, transparent);
    background-color: white;
    padding: 0.65rem 0.9rem;
    font-size: 0.95rem;
    color: var(--color-ink);
  }

  :global(.field-input:focus-visible) {
    outline: 2px solid var(--color-gold-dark);
    outline-offset: 1px;
    border-color: var(--color-gold-dark);
  }

  :global(.field-error) {
    margin-top: 0.375rem;
    min-height: 1rem;
    font-size: 0.8rem;
    color: #b42318;
  }

  :global(.field-error:empty) {
    display: none;
  }

  .honeypot-field {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
</style>
