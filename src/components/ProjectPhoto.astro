---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Ratio = 'hero' | 'wide' | 'tall' | 'square' | 'landscape';

interface Props {
  src: ImageMetadata;
  alt: string;
  ratio?: Ratio;
  class?: string;
  bordered?: boolean;
  /** Slow continuous zoom, for hero-style full-bleed photos. */
  kenburns?: boolean;
  /** Zoom in when a `.group` ancestor is hovered, for interactive tiles/cards. */
  hoverZoom?: boolean;
  widths?: number[];
  sizes?: string;
}

const {
  src,
  alt,
  ratio = 'square',
  class: className = '',
  bordered = false,
  kenburns = false,
  hoverZoom = false,
  widths = [480, 768, 1024, 1600],
  sizes = '100vw',
} = Astro.props;

const ratioClasses: Record<Ratio, string> = {
  hero: 'aspect-[16/10]',
  wide: 'aspect-[21/9]',
  tall: 'aspect-[3/4]',
  square: 'aspect-square',
  landscape: 'aspect-[4/3]',
};
---

<div class:list={['relative overflow-hidden bg-surface', ratioClasses[ratio], { 'border border-gold/20': bordered }, className]}>
  <Image
    src={src}
    alt={alt}
    widths={widths}
    sizes={sizes}
    class:list={[
      'absolute inset-0 h-full w-full object-cover transition-transform duration-700 ease-out',
      { 'animate-kenburns': kenburns, 'group-hover:scale-110': hoverZoom },
    ]}
  />
</div>
