---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { Image } from 'astro:assets';
import logo from '../../assets/brand/logo.jpeg';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import SectionHeading from '../SectionHeading.astro';
import CtaBand from '../CtaBand.astro';
import Icon, { type IconName } from '../Icon.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const processIcons: IconName[] = ['consult', 'design', 'execute', 'handover'];
---

<section class="border-b border-gold/10">
  <div class="container-page grid items-center gap-12 py-16 sm:py-20 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-7">
      <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-gold-deep">{t.about.kicker}</p>
      <h1 class="text-balance text-4xl font-bold leading-tight text-ink sm:text-5xl">{t.about.title}</h1>
      <p class="mt-6 text-balance text-xl leading-relaxed text-ink">{t.about.introLead}</p>
      <p class="prose-body mt-5 max-w-2xl text-base">{t.about.introBody}</p>
    </div>
    <div class="lg:col-span-5">
      <div class="mx-auto max-w-sm overflow-hidden rounded-2xl border border-gold/15 bg-white shadow-sm">
        <Image src={logo} alt="Howida design studio" width={480} height={327} loading="eager" class="h-auto w-full" />
      </div>
    </div>
  </div>
</section>

<section class="border-b border-gold/10 bg-cream-dark/50">
  <div class="container-page py-16 sm:py-20">
    <SectionHeading kicker={t.about.valuesKicker} title={t.about.valuesTitle} align="center" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.about.values.map((value) => (
          <div class="rounded-2xl bg-white/70 p-6">
            <p class="font-semibold text-ink">{value.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-body">{value.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="border-b border-gold/10">
  <div class="container-page py-16 sm:py-20">
    <SectionHeading kicker={t.about.approachKicker} title={t.about.approachTitle} align="center" />
    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.home.processSteps.map((step, index) => (
          <li class="relative rounded-2xl border border-gold/15 p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-gold-deep">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="mt-3 flex h-11 w-11 items-center justify-center rounded-xl bg-gold-light/60 text-gold-deep">
              <Icon name={processIcons[index]} class="h-5 w-5" />
            </span>
            <p class="mt-4 font-semibold text-ink">{step.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="border-b border-gold/10 bg-cream-dark/50">
  <div class="container-page flex flex-col items-center gap-4 py-12 text-center sm:py-14">
    <span class="flex h-12 w-12 items-center justify-center rounded-full bg-gold-light/60 text-gold-deep">
      <Icon name="map-pin" class="h-6 w-6" />
    </span>
    <h2 class="text-2xl font-bold text-ink">{t.about.coverageTitle}</h2>
    <p class="max-w-xl text-balance text-body">{t.about.coverageBody}</p>
  </div>
</section>

<CtaBand title={t.about.ctaTitle} buttonLabel={t.about.ctaButton} buttonHref={getRelativeLocaleUrl(lang, 'contact')} />
