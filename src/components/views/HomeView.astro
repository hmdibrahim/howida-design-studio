---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import SectionHeading from '../SectionHeading.astro';
import ServiceCard from '../ServiceCard.astro';
import CtaBand from '../CtaBand.astro';
import Button from '../Button.astro';
import Icon, { type IconName } from '../Icon.astro';
import ProjectPhoto from '../ProjectPhoto.astro';
import heroPhoto from '../../assets/photos/project-living-room-wide-1.jpg';
import portfolioPhoto1 from '../../assets/photos/project-living-room-wide-2.jpg';
import portfolioPhoto2 from '../../assets/photos/project-display-shelving.jpg';
import portfolioPhoto3 from '../../assets/photos/project-sofa-art-panel.jpg';
import portfolioPhoto4 from '../../assets/photos/project-seating-area-1.jpg';
import portfolioPhoto5 from '../../assets/photos/project-seating-area-2.jpg';
import portfolioPhoto6 from '../../assets/photos/project-corner-sofa.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allServices = await getCollection('services', (entry) => entry.id.startsWith(`${lang}/`));
const services = allServices.sort((a, b) => a.data.order - b.data.order);

const portfolioPhotos = [portfolioPhoto1, portfolioPhoto2, portfolioPhoto3, portfolioPhoto4, portfolioPhoto5, portfolioPhoto6];
const heroSlides = [heroPhoto, portfolioPhoto4, portfolioPhoto2, portfolioPhoto5, portfolioPhoto3];

const whyIcons: IconName[] = ['users', 'layers', 'message-circle', 'map'];
const processIcons: IconName[] = ['consult', 'design', 'execute', 'handover'];
---

<section class="relative -mt-[4.5rem] h-[32rem] overflow-hidden sm:h-[40rem] lg:h-[46rem]">
  <div class="absolute inset-0 h-[120%]" data-parallax>
    {
      heroSlides.map((slide, index) => (
        <Image
          src={slide}
          alt=""
          loading={index === 0 ? 'eager' : 'lazy'}
          fetchpriority={index === 0 ? 'high' : undefined}
          widths={[640, 1024, 1600, 2000]}
          sizes="100vw"
          data-hero-slide
          class:list={[
            'absolute inset-0 h-full w-full object-cover transition-opacity duration-[1800ms] ease-in-out',
            index === 0 ? 'opacity-100' : 'opacity-0',
            { 'animate-kenburns': index === 0 },
          ]}
        />
      ))
    }
    {/* Scrims: a start-side gradient for the text block, a top strip so the transparent header stays legible, and a bottom vignette. */}
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-black/70 via-black/35 to-transparent rtl:bg-gradient-to-l" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-x-0 top-0 h-[4.5rem] bg-gradient-to-b from-black/55 to-transparent" aria-hidden="true" />
    <div class="pointer-events-none absolute inset-x-0 bottom-0 h-1/2 bg-gradient-to-t from-black/45 to-transparent" aria-hidden="true" />
  </div>
  <div class="container-page relative flex h-full flex-col justify-end pb-14 sm:pb-20">
    <div class="max-w-xl animate-fade-up">
      <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-gold-on-dark">{t.home.heroKicker}</p>
      <h1 class="font-heading text-balance text-4xl leading-[1.1] text-white sm:text-5xl lg:text-6xl">
        {t.home.heroTitle}
      </h1>
      <p class="mt-6 text-balance text-lg leading-relaxed text-white/85">
        {t.home.heroSubtitle}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <Button href={getRelativeLocaleUrl(lang, 'contact')} variant="primary" class="px-7 py-3.5 text-base">
          {t.home.heroCtaPrimary}
        </Button>
        <Button href={getRelativeLocaleUrl(lang, 'services')} variant="outline-on-dark" class="px-7 py-3.5 text-base">
          {t.home.heroCtaSecondary}
        </Button>
      </div>
    </div>
  </div>
</section>

<section class="border-b border-hairline">
  <div class="container-page py-16 sm:py-20">
    <SectionHeading kicker={t.home.portfolio.kicker} title={t.home.portfolio.title} subtitle={t.home.portfolio.subtitle} align="center" />
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-12 lg:gap-5">
      {
        t.home.portfolio.items.map((item, index) => {
          const pair = Math.floor(index / 2);
          const isFirstInPair = index % 2 === 0;
          const big = pair % 2 === 0 ? isFirstInPair : !isFirstInPair;
          return (
            <div class:list={[big ? 'lg:col-span-7' : 'lg:col-span-5']} data-reveal style={`--reveal-delay: ${index * 90}ms`}>
              <a href={getRelativeLocaleUrl(lang, 'services')} class="group block">
                <ProjectPhoto src={portfolioPhotos[index]} alt={item.category} ratio={big ? 'landscape' : 'square'} hoverZoom />
                <p class="mt-3 text-sm font-medium uppercase tracking-wide text-body transition-colors group-hover:text-ink">
                  {item.category}
                </p>
              </a>
            </div>
          );
        })
      }
    </div>
    <div class="mt-10 flex justify-center" data-reveal>
      <Button href={getRelativeLocaleUrl(lang, 'services')} variant="secondary">
        {t.home.portfolio.cta}
      </Button>
    </div>
  </div>
</section>

<section class="border-b border-hairline bg-cream-dark/50">
  <div class="container-page grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7" data-reveal>
      <SectionHeading kicker={t.home.aboutKicker} title={t.home.aboutTitle} />
      <p class="prose-body mt-5 max-w-2xl text-base">{t.home.aboutBody}</p>
      <Button href={getRelativeLocaleUrl(lang, 'about')} variant="secondary" class="mt-7">
        {t.home.aboutCta}
        <Icon name="arrow-right" class="h-4 w-4 rtl:rotate-180" />
      </Button>
    </div>
    <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-5">
      {
        t.about.values.map((value, index) => (
          <li
            class:list={['rounded-sm border border-hairline bg-white p-5', { 'lg:mt-6': index % 2 === 1 }]}
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <p class="font-semibold text-ink">{value.title}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-body">{value.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section id="services" class="border-b border-hairline">
  <div class="container-page py-16 sm:py-20">
    <SectionHeading kicker={t.home.servicesKicker} title={t.home.servicesTitle} subtitle={t.home.servicesSubtitle} align="center" />
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service, index) => (
          <ServiceCard
            href={getRelativeLocaleUrl(lang, `services/${service.id.split('/')[1]}`)}
            icon={service.data.icon}
            title={service.data.title}
            summary={service.data.summary}
            arrowLabel={t.common.learnMore}
            index={index}
          />
        ))
      }
    </div>
  </div>
</section>

<section class="border-b border-hairline bg-cream-dark/50">
  <div class="container-page py-16 sm:py-20">
    <SectionHeading kicker={t.home.whyKicker} title={t.home.whyTitle} align="center" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.home.whyItems.map((item, index) => (
          <div
            class:list={['rounded-sm border border-hairline bg-white p-6 text-center', { 'lg:mt-8': index % 2 === 1 }]}
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <span class="mx-auto flex h-12 w-12 items-center justify-center border border-hairline text-gold-deep">
              <Icon name={whyIcons[index]} class="h-6 w-6" />
            </span>
            <p class="mt-4 font-semibold text-ink">{item.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-body">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="border-b border-hairline">
  <div class="container-page py-16 sm:py-20">
    <SectionHeading kicker={t.home.processKicker} title={t.home.processTitle} align="center" />
    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.home.processSteps.map((step, index) => (
          <li
            class:list={['relative rounded-sm border border-hairline p-6', { 'lg:mt-8': index % 2 === 1 }]}
            data-reveal
            style={`--reveal-delay: ${index * 90}ms`}
          >
            <span class="text-xs font-semibold uppercase tracking-wider text-gold-deep">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="mt-3 flex h-11 w-11 items-center justify-center border border-hairline text-gold-deep">
              <Icon name={processIcons[index]} class="h-5 w-5" />
            </span>
            <p class="mt-4 font-semibold text-ink">{step.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="border-b border-hairline bg-cream-dark/50">
  <div class="container-page flex flex-col items-center gap-4 py-12 text-center sm:py-14" data-reveal>
    <Icon name="map-pin" class="h-7 w-7 text-gold-deep" />
    <h2 class="font-heading text-2xl text-ink">{t.home.coverageTitle}</h2>
    <p class="max-w-xl text-balance text-body">{t.home.coverageBody}</p>
  </div>
</section>

<CtaBand title={t.home.ctaTitle} subtitle={t.home.ctaSubtitle} buttonLabel={t.home.ctaButton} buttonHref={getRelativeLocaleUrl(lang, 'contact')} />

<script>
  const parallaxEl = document.querySelector<HTMLElement>('[data-parallax]');
  const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (parallaxEl && !prefersReducedMotion) {
    let ticking = false;
    const onScroll = () => {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(() => {
        const shift = Math.min(window.scrollY * 0.15, 60);
        parallaxEl.style.transform = `translateY(${shift}px)`;
        ticking = false;
      });
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const heroSlides = document.querySelectorAll<HTMLElement>('[data-hero-slide]');
  if (heroSlides.length > 1 && !prefersReducedMotion) {
    let activeIndex = 0;
    setInterval(() => {
      const nextIndex = (activeIndex + 1) % heroSlides.length;
      heroSlides[activeIndex].classList.replace('opacity-100', 'opacity-0');
      heroSlides[nextIndex].classList.replace('opacity-0', 'opacity-100');
      activeIndex = nextIndex;
    }, 5000);
  }
</script>
