---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { getCollection } from 'astro:content';
import { useTranslations } from '../../i18n/utils';
import type { Lang } from '../../i18n/ui';
import SectionHeading from '../SectionHeading.astro';
import ServiceCard from '../ServiceCard.astro';
import CtaBand from '../CtaBand.astro';
import Button from '../Button.astro';
import Icon, { type IconName } from '../Icon.astro';
import PlaceholderImage from '../PlaceholderImage.astro';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const allServices = await getCollection('services', (entry) => entry.id.startsWith(`${lang}/`));
const services = allServices.sort((a, b) => a.data.order - b.data.order);

const whyIcons: IconName[] = ['users', 'layers', 'message-circle', 'map'];
const processIcons: IconName[] = ['consult', 'design', 'execute', 'handover'];
---

<section class="relative -mt-[4.5rem] h-[32rem] overflow-hidden sm:h-[40rem] lg:h-[46rem]">
  <PlaceholderImage ratio="hero" bordered={false} class="absolute inset-0 h-full w-full" />
  <div class="container-page relative flex h-full flex-col justify-end pb-14 sm:pb-20">
    <div class="max-w-xl animate-fade-up">
      <p class="mb-4 text-sm font-semibold uppercase tracking-wider text-gold-deep">{t.home.heroKicker}</p>
      <h1 class="font-heading text-balance text-4xl leading-[1.1] text-ink sm:text-5xl lg:text-6xl">
        {t.home.heroTitle}
      </h1>
      <p class="mt-6 text-balance text-lg leading-relaxed text-body">
        {t.home.heroSubtitle}
      </p>
      <div class="mt-9 flex flex-wrap items-center gap-4">
        <Button href={getRelativeLocaleUrl(lang, 'contact')} variant="primary" class="px-7 py-3.5 text-base">
          {t.home.heroCtaPrimary}
        </Button>
        <Button href={getRelativeLocaleUrl(lang, 'services')} variant="secondary" class="px-7 py-3.5 text-base">
          {t.home.heroCtaSecondary}
        </Button>
      </div>
    </div>
  </div>
</section>

<section class="border-b border-hairline">
  <div class="container-page py-16 sm:py-20">
    <SectionHeading kicker={t.home.portfolio.kicker} title={t.home.portfolio.title} subtitle={t.home.portfolio.subtitle} align="center" />
    <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        t.home.portfolio.items.map((item) => (
          <div>
            <PlaceholderImage ratio="square" label={item.category} />
            <p class="mt-3 text-sm font-medium uppercase tracking-wide text-body">{item.category}</p>
          </div>
        ))
      }
    </div>
    <div class="mt-10 flex justify-center">
      <Button href={getRelativeLocaleUrl(lang, 'services')} variant="secondary">
        {t.home.portfolio.cta}
      </Button>
    </div>
  </div>
</section>

<section class="border-b border-hairline bg-cream-dark/50">
  <div class="container-page grid items-center gap-10 py-16 sm:py-20 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      <SectionHeading kicker={t.home.aboutKicker} title={t.home.aboutTitle} />
      <p class="prose-body mt-5 max-w-2xl text-base">{t.home.aboutBody}</p>
      <Button href={getRelativeLocaleUrl(lang, 'about')} variant="secondary" class="mt-7">
        {t.home.aboutCta}
        <Icon name="arrow-right" class="h-4 w-4 rtl:rotate-180" />
      </Button>
    </div>
    <ul class="grid gap-4 sm:grid-cols-2 lg:col-span-5">
      {
        t.about.values.map((value) => (
          <li class="rounded-sm border border-hairline bg-white p-5">
            <p class="font-semibold text-ink">{value.title}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-body">{value.body}</p>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<section id="services" class="border-b border-hairline">
  <div class="container-page py-16 sm:py-20">
    <SectionHeading kicker={t.home.servicesKicker} title={t.home.servicesTitle} subtitle={t.home.servicesSubtitle} align="center" />
    <div class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {
        services.map((service) => (
          <ServiceCard
            href={getRelativeLocaleUrl(lang, `services/${service.id.split('/')[1]}`)}
            icon={service.data.icon}
            title={service.data.title}
            summary={service.data.summary}
            arrowLabel={t.common.learnMore}
          />
        ))
      }
    </div>
  </div>
</section>

<section class="border-b border-hairline bg-cream-dark/50">
  <div class="container-page py-16 sm:py-20">
    <SectionHeading kicker={t.home.whyKicker} title={t.home.whyTitle} align="center" />
    <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.home.whyItems.map((item, index) => (
          <div class="rounded-sm border border-hairline bg-white p-6 text-center">
            <span class="mx-auto flex h-12 w-12 items-center justify-center border border-hairline text-gold-deep">
              <Icon name={whyIcons[index]} class="h-6 w-6" />
            </span>
            <p class="mt-4 font-semibold text-ink">{item.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-body">{item.body}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>

<section class="border-b border-hairline">
  <div class="container-page py-16 sm:py-20">
    <SectionHeading kicker={t.home.processKicker} title={t.home.processTitle} align="center" />
    <ol class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        t.home.processSteps.map((step, index) => (
          <li class="relative rounded-sm border border-hairline p-6">
            <span class="text-xs font-semibold uppercase tracking-wider text-gold-deep">
              {String(index + 1).padStart(2, '0')}
            </span>
            <span class="mt-3 flex h-11 w-11 items-center justify-center border border-hairline text-gold-deep">
              <Icon name={processIcons[index]} class="h-5 w-5" />
            </span>
            <p class="mt-4 font-semibold text-ink">{step.title}</p>
            <p class="mt-2 text-sm leading-relaxed text-body">{step.body}</p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<section class="border-b border-hairline bg-cream-dark/50">
  <div class="container-page flex flex-col items-center gap-4 py-12 text-center sm:py-14">
    <Icon name="map-pin" class="h-7 w-7 text-gold-deep" />
    <h2 class="font-heading text-2xl text-ink">{t.home.coverageTitle}</h2>
    <p class="max-w-xl text-balance text-body">{t.home.coverageBody}</p>
  </div>
</section>

<CtaBand title={t.home.ctaTitle} subtitle={t.home.ctaSubtitle} buttonLabel={t.home.ctaButton} buttonHref={getRelativeLocaleUrl(lang, 'contact')} />
