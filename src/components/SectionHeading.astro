---
interface Props {
  kicker?: string;
  title: string;
  subtitle?: string;
  align?: 'start' | 'center';
  tone?: 'light' | 'dark';
  as?: 'h1' | 'h2' | 'h3';
}

const { kicker, title, subtitle, align = 'start', tone = 'light', as: Tag = 'h2' } = Astro.props;
const isCenter = align === 'center';
const isDark = tone === 'dark';
---

<div class:list={['max-w-2xl', { 'mx-auto text-center': isCenter }]}>
  {kicker && (
    <p class:list={['mb-3 text-sm font-semibold uppercase tracking-wider', isDark ? 'text-gold-on-dark' : 'text-gold-deep']}>
      {kicker}
    </p>
  )}
  <Tag class:list={['text-balance text-3xl font-bold leading-tight sm:text-4xl', isDark ? 'text-white' : 'text-ink']}>
    {title}
  </Tag>
  {subtitle && (
    <p class:list={['mt-4 text-balance text-lg leading-relaxed', isDark ? 'text-cream/75' : 'text-body']}>
      {subtitle}
    </p>
  )}
</div>
