---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['flex items-center justify-center', className]} aria-hidden="true" data-reveal>
  <span class="h-px w-16 origin-right bg-gold/40 [.is-visible_&]:animate-rule-grow"></span>
  <span class="mx-3 h-1.5 w-1.5 rotate-45 border border-gold-dark"></span>
  <span class="h-px w-16 origin-left bg-gold/40 [.is-visible_&]:animate-rule-grow"></span>
</div>
