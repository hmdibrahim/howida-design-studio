---
interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<div class:list={['flex items-center justify-center', className]} aria-hidden="true">
  <span class="h-px w-16 bg-gold/40"></span>
  <span class="mx-3 h-1.5 w-1.5 rotate-45 border border-gold-dark"></span>
  <span class="h-px w-16 bg-gold/40"></span>
</div>
