---
type Ratio = 'hero' | 'wide' | 'tall' | 'square';

interface Props {
  ratio?: Ratio;
  class?: string;
  label?: string;
  bordered?: boolean;
}

const { ratio = 'square', class: className = '', label, bordered = true } = Astro.props;

const ratioClasses: Record<Ratio, string> = {
  hero: 'aspect-[16/10]',
  wide: 'aspect-[21/9]',
  tall: 'aspect-[3/4]',
  square: 'aspect-square',
};
---

<div
  class:list={['relative overflow-hidden bg-surface', ratioClasses[ratio], { 'border border-gold/20': bordered }, className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : true}
>
  <div
    class="absolute inset-0"
    style="background-image: linear-gradient(135deg, var(--color-surface) 0%, var(--color-surface-deep) 60%, var(--color-cream-dark) 100%);"
  >
  </div>
</div>
