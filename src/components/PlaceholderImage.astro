---
type Ratio = 'hero' | 'wide' | 'tall' | 'square' | 'landscape';

interface Props {
  ratio?: Ratio;
  class?: string;
  label?: string;
  bordered?: boolean;
  /** Slow continuous zoom, for hero-style full-bleed placeholders. */
  kenburns?: boolean;
  /** Zoom in when a `.group` ancestor is hovered, for interactive tiles/cards. */
  hoverZoom?: boolean;
}

const { ratio = 'square', class: className = '', label, bordered = true, kenburns = false, hoverZoom = false } = Astro.props;

const ratioClasses: Record<Ratio, string> = {
  hero: 'aspect-[16/10]',
  wide: 'aspect-[21/9]',
  tall: 'aspect-[3/4]',
  square: 'aspect-square',
  landscape: 'aspect-[4/3]',
};
---

<div
  class:list={['relative overflow-hidden bg-surface', ratioClasses[ratio], { 'border border-gold/20': bordered }, className]}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : true}
>
  <div
    class:list={[
      'absolute inset-0 transition-transform duration-700 ease-out',
      { 'animate-kenburns': kenburns, 'group-hover:scale-110': hoverZoom },
    ]}
    style="background-image: linear-gradient(135deg, var(--color-surface) 0%, var(--color-surface-deep) 60%, var(--color-cream-dark) 100%);"
  >
  </div>
</div>
